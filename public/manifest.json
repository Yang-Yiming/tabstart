{
  "manifest_version": 3,
  "name": "TabStart",
  "version": "0.1.0",
  "description": "A lightweight personal new tab dashboard.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://bing.ee123.net/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
