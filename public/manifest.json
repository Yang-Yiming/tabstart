{
  "manifest_version": 3,
  "name": "TabStart",
  "version": "0.1.0",
  "description": "A lightweight personal new tab dashboard.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://bing.ee123.net/*",
    "https://api.deepseek.com/*",
    "https://opencode.ai/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
